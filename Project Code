##Only run in high RAM Colab environment
time_series_data <- final_dataset %>%
  select(Issue_Date, FAR_Utilization, Borough) %>%
  filter(
    !is.na(Issue_Date),
    Issue_Date >= as.Date("2012-01-01"),
    Issue_Date <= as.Date("2025-11-01"),
    FAR_Utilization <= 3
  )

# Define Events
events <- data.frame(
  Date = as.Date(c("2016-03-22", "2020-03-20", "2022-06-15")),
  Event = c("ZQA Amendments", "COVID-19 Shutdown", "421-a Expiration"),
  Y_Pos = c(1.4, 1.4, 1.4)
)

# Create Plot using GAM
ggplot(time_series_data, aes(x = Issue_Date, y = FAR_Utilization)) +
  # Plot all points
  geom_point(alpha = 0.1, color = "gray", size = 0.5) +
  
  # GAM Model used instead of LOESS beacuse of compute restraints.
  geom_smooth(method = "gam", formula = y ~ s(x, bs = "cs"), 
              color = "red", linewidth = 1.2, fill = "red", alpha = 0.2) +
  
  # Reference Lines
  geom_hline(yintercept = 1.0, linetype = "dashed", color = "black", linewidth = 0.8) +
  annotate("text", x = as.Date("2012-07-01"), y = 1.05, label = "Max Allowed FAR (1.0)", hjust = 0, fontface = "italic") +
  
  # Event Lines
  geom_vline(data = events, aes(xintercept = Date), linetype = "dotted", color = "blue", linewidth = 0.8) +
  geom_text(data = events, aes(x = Date, y = Y_Pos, label = Event), 
            color = "blue", angle = 90, vjust = -0.5, size = 3.5) +
  scale_x_date(date_breaks = "1 year", date_labels = "%Y") +
  coord_cartesian(ylim = c(0, 1.6)) + 
  theme_minimal() +
  labs(
    title = "Trends in Zoning Utilization: NYC Residential Buildings (2012-2025)",
    x = "Certificate of Occupancy Issue Date",
    y = "Zoning Utilization Ratio"
  )
