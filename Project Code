#Logistic Regression
logit_model <- glm(Maxed_Out ~ 
                     Borough + 
                     Zoning_Category + 
                     Is_Landmark + 
                     Is_Irregular + 
                     Job_Type +             
                     LotSize +              
                     Land_Value_Per_SqFt, 
                   data = final_dataset,
                   family = "binomial")

summary(logit_model)
exp(coef(logit_model))
vif(logit_model)

#Create a Bootstrapped 95% CI for the logistic regression coefficients (Only run in high ram environment)
glm_coef_fn <- function(data, indices) {
  d <- data[indices, ]
  fit <- glm(Maxed_Out ~ 
               Borough + 
               Zoning_Category + 
               Is_Landmark + 
               Is_Irregular + 
               Job_Type + 
               LotSize + 
               Land_Value_Per_SqFt, 
             data = d, 
             family = "binomial")
  
  return(coef(fit))
}
set.seed(2025)
boot_results <- boot(data = final_dataset,
                     statistic = glm_coef_fn, 
                     R = 1000)
print(boot_results)

